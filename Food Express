function openTracking(no){
 var all=JSON.parse(localStorage.getItem("fe_allOrders")||"[]");
 var o=all.find(function(x){return x.no==no}); if(!o) return;
 showPage('trackPage');
 var steps=['Order Placed','Confirmed','Out for Delivery','Delivered'];
 var cur=steps.indexOf(o.status||'Order Placed'); if(cur==-1) cur=0;
 var html='<div style="background:white;padding:15px;border-radius:12px"><b>#'+o.no+'</b> - <b style="color:#FF8C00">'+o.total+'</b><p style="font-size:12px;color:gray;margin-top:6px">'+o.name+' +91'+o.mobile+'</p><p style="font-size:12px">'+o.itemsText+'</p></div><div style="background:white;padding:15px;border-radius:12px;margin-top:12px">';
 for(var i=0;i<steps.length;i++){var active=i<=cur?'':'opacity:0.4';var icon=i<=cur?'✓':'○';
 html+='<div style="display:flex;gap:12px;margin-bottom:10px;'+active+'"><div style="width:28px;height:28px;border-radius:50%;background:'+(i<=cur?'#25D366':'#ddd')+';color:white;display:flex;align-items:center;justify-content:center">'+icon+'</div><div><b style="font-size:13px">'+steps[i]+'</b></div></div>';
 if(i<3) html+='<div style="width:2px;height:12px;background:'+(i<cur?'#25D366':'#ddd')+';margin-left:13px;margin-top:-5px;margin-bottom:5px"></div>';}
 html+='</div><a href="https://wa.me/918984484727?text=Order '+o.no+' status?" style="display:block;text-align:center;margin-top:15px;background:#25D366;color:white;padding:12px;border-radius:10px;text-decoration:none">💬 WhatsApp Support</a>';
 document.getElementById('trackDetails').innerHTML=html;
}
function loadAdminOrders(){
 var all=JSON.parse(localStorage.getItem("fe_allOrders")||"[]");
 document.getElementById('totalOrders').innerText=all.length;
 document.getElementById('todayOrders').innerText=all.length;
 var list=document.getElementById('adminOrdersList');
 if(all.length==0){list.innerHTML="<p style='text-align:center;color:gray'>No orders</p>";return;}
 var html="";
 for(var i=all.length-1;i>=0;i--){var o=all[i];
 html+='<div style="background:white;margin-top:10px;border-left:4px solid #25D366;padding:10px;border-radius:8px"><div style="display:flex;justify-content:space-between"><b>#'+o.no+'</b><small>'+o.date+'</small></div><p style="font-size:13px"><b>'+o.name+'</b> +91'+o.mobile+'</p><p style="font-size:12px">'+o.itemsText+'</p><b style="color:#FF8C00">'+o.total+'</b><div style="display:flex;gap:8px;margin-top:8px"><a href="tel:+91'+o.mobile+'" style="flex:1;background:#0A1931;color:white;text-align:center;padding:8px;border-radius:8px;text-decoration:none">📞 Call</a><a href="https://wa.me/91'+o.mobile+'?text=Hi '+o.name+' Order '+o.no+' '+ (o.status||'Placed')+'" style="flex:1;background:#25D366;color:white;text-align:center;padding:8px;border-radius:8px;text-decoration:none">💬 WhatsApp</a></div></div>';}
 list.innerHTML=html;
}
</script>
