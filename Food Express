<script>
var currentStore = "queens";
var stores = {
  queens: {name:"Queens Cafe",emoji:"👑",addr:"Near Hero Showroom",time:"30 mins",rating:"4.5"},
  sharma: {name:"Sharma Cafe",emoji:"☕",addr:"Main Market, Karanjia",time:"25 mins",rating:"4.3"},
  shankar: {name:"Shankar Plaza",emoji:"🍰",addr:"Bus Stand Road",time:"15 mins",rating:"4.6"}
};
var menuData = {
queens: [
{name:"Chicken Manchow Soup",price:139,emoji:"🍲",cat:"Soup"},{name:"Chicken Hot N Sour Soup",price:129,emoji:"🍲",cat:"Soup"},{name:"Chicken Sweetcorn Soup",price:129,emoji:"🍲",cat:"Soup"},{name:"Chicken Burnt Garlic Soup",price:159,emoji:"🍲",cat:"Soup"},{name:"Chicken Lollypop",price:289,emoji:"🍗",cat:"Starter"},{name:"Chicken Pokoda 12 PCS",price:209,emoji:"🍗",cat:"Starter"},{name:"Chicken Chilly",price:249,emoji:"🍗",cat:"Starter"},{name:"Chicken 65",price:259,emoji:"🍗",cat:"Starter"},{name:"Dragon Chicken",price:269,emoji:"🍗",cat:"Starter"},{name:"Chilly Paneer",price:209,emoji:"🧀",cat:"Starter"},{name:"Spcl Hyd Chicken Dum Biryani",price:209,emoji:"🍛",cat:"Biryani"},{name:"Spcl Hyd Mutton Dum Biryani",price:339,emoji:"🍛",cat:"Biryani"},{name:"Mix Veg Hakka Noodles",price:189,emoji:"🍜",cat:"Noodles"},{name:"Chicken Hakka Noodles",price:209,emoji:"🍜",cat:"Noodles"},{name:"Veg Roll",price:139,emoji:"🌯",cat:"Roll"},{name:"Egg Chicken Roll",price:179,emoji:"🌯",cat:"Roll"},{name:"Tandoor Roti",price:49,emoji:"🫓",cat:"Tandoori"},{name:"Butter Naan",price:79,emoji:"🫓",cat:"Tandoori"},{name:"Chicken Tikka 6 PCS",price:289,emoji:"🍢",cat:"Tandoor"},{name:"Plain Rice",price:79,emoji:"🍚",cat:"Rice"},{name:"Jeera Rice",price:89,emoji:"🍚",cat:"Rice"},{name:"Chicken Butter Masala 5PC",price:279,emoji:"🍗",cat:"Main"},{name:"Mutton Masala",price:359,emoji:"🍖",cat:"Main"},{name:"Paneer Butter Masala",price:289,emoji:"🧀",cat:"Main"},{name:"Mix Veg Fried Rice",price:199,emoji:"🍚",cat:"Fried Rice"},{name:"Chicken Fried Rice",price:249,emoji:"🍚",cat:"Fried Rice"},{name:"Chefs Spcl Double Ka Mitha",price:69,emoji:"🍮",cat:"Dessert"},{name:"Icecream",price:69,emoji:"🍦",cat:"Dessert"}
],
sharma: [
{name:"Sharma Special Chai",price:39,emoji:"☕",cat:"Tea"},{name:"Masala Chai",price:49,emoji:"☕",cat:"Tea"},{name:"Cold Coffee",price:89,emoji:"🥤",cat:"Tea"},{name:"Veg Puff",price:39,emoji:"🥐",cat:"Snacks"},{name:"Paneer Puff",price:59,emoji:"🥐",cat:"Snacks"},{name:"Samosa 2 PCS",price:49,emoji:"🥟",cat:"Snacks"},{name:"Aloo Tikki Burger",price:79,emoji:"🍔",cat:"Burger"},{name:"Veg Cheese Burger",price:109,emoji:"🍔",cat:"Burger"},{name:"Chicken Burger",price:139,emoji:"🍔",cat:"Burger"},{name:"Veg Sandwich",price:89,emoji:"🥪",cat:"Sandwich"},{name:"Grilled Paneer Sandwich",price:129,emoji:"🥪",cat:"Sandwich"},{name:"French Fries",price:89,emoji:"🍟",cat:"Snacks"}
],
shankar: [
{name:"Pizza",price:80,emoji:"🍕",cat:"Bakery"},
{name:"Patties",price:40,emoji:"🥟",cat:"Bakery"},
{name:"Pastry",price:35,emoji:"🍰",cat:"Bakery"}
]
};
var cart=[];
function renderStoresBar(){
var bar=document.getElementById('storesBar');bar.innerHTML='';
for(var id in stores){
var s=stores[id];
var active=currentStore==id?'border:2px solid #FF8C00;background:#FFF8E1':'background:white;border:2px solid transparent';
bar.innerHTML+='<div onclick="selectStore(\''+id+'\')" style="'+active+';min-width:140px;border-radius:16px;padding:12px;box-shadow:0 2px 8px rgba(0,0,0,0.06);cursor:pointer;text-align:center"><div style="font-size:32px">'+s.emoji+'</div><p style="font-size:13px;font-weight:800;color:#0A1931;margin-top:4px">'+s.name+'</p><p style="font-size:10px;color:gray">'+s.rating+'⭐ • '+s.time+'</p><p style="font-size:9px;color:gray;margin-top:2px">'+s.addr+'</p></div>';
}
}
function selectStore(id){currentStore=id;renderStoresBar();renderSelectedStore();renderCat();renderItems(menuData[id]);}
function renderSelectedStore(){
var s=stores[currentStore];
document.getElementById('selectedStoreCard').innerHTML='<div style="font-size:28px">'+s.emoji+'</div><div style="flex:1"><h3 style="font-size:14px;color:#0A1931">'+s.name+'</h3><p style="font-size:11px;color:gray">'+s.addr+' • '+s.time+' • '+s.rating+'⭐</p><p style="font-size:10px;color:#FF8C00;font-weight:700;margin-top:2px">'+menuData[currentStore].length+' items available</p></div><div style="background:#0A1931;color:white;padding:6px 10px;border-radius:8px;font-size:11px">OPEN</div>';
}
function renderCat(){
var allCats=[];var list=menuData[currentStore];
for(var i=0;i<list.length;i++) if(allCats.indexOf(list[i].cat)==-1) allCats.push(list[i].cat);
var row=document.getElementById('catRow');row.innerHTML='<div onclick="renderItems(menuData[currentStore])" style="background:#0A1931;color:white;padding:8px 14px;border-radius:20px;font-size:12px;white-space:nowrap;cursor:pointer">All</div>';
for(var c=0;c<allCats.length;c++) row.innerHTML+='<div onclick="filterCat(\''+allCats[c]+'\')" style="background:white;padding:8px 14px;border-radius:20px;font-size:12px;white-space:nowrap;box-shadow:0 1px 4px rgba(0,0,0,0.08);cursor:pointer">'+allCats[c]+'</div>';
}
function renderItems(list){
var div=document.getElementById('itemsList');div.innerHTML='';
for(var i=0;i<list.length;i++){
var it=list[i];
div.innerHTML+='<div style="background:white;margin:10px 14px;border-radius:16px;padding:14px;display:flex;gap:12px;align-items:center;box-shadow:0 2px 8px rgba(0,0,0,0.05)"><div style="font-size:28px">'+it.emoji+'</div><div style="flex:1"><h4 style="font-size:14px;color:#0A1931">'+it.name+'</h4><p style="font-size:11px;color:gray">'+it.cat+'</p><p style="color:#FF8C00;font-weight:800;margin-top:2px">₹'+it.price+'</p></div><button onclick="addCart(\''+it.name+'\','+it.price+')" style="background:#FF8C00;color:white;border:none;padding:8px 16px;border-radius:10px;font-weight:800;font-size:12px">ADD</button></div>';
}
}
function filterCat(c){var f=[];var list=menuData[currentStore];for(var i=0;i<list.length;i++) if(list[i].cat==c) f.push(list[i]);renderItems(f);}
function doSearch(q){if(!q){renderItems(menuData[currentStore]);return;}q=q.toLowerCase();var f=[];var list=menuData[currentStore];for(var i=0;i<list.length;i++) if(list[i].name.toLowerCase().indexOf(q)!=-1) f.push(list[i]);renderItems(f);}
function addCart(name,price){var found=null;for(var j=0;j<cart.length;j++) if(cart[j].name==name) found=cart[j];if(found) found.qty++;else cart.push({name:name,price:price,qty:1,store:currentStore});updateCartUI();}
function updateCartUI(){var c=0,t=0;for(var k=0;k<cart.length;k++){c+=cart[k].qty;t+=cart[k].price*cart[k].qty;}if(c>0){document.getElementById('cartBar').style.display='flex';document.getElementById('cartBadge').style.display='block';}else{document.getElementById('cartBar').style.display='none';document.getElementById('cartBadge').style.display='none';}document.getElementById('cartCount').innerText=c+' Items';document.getElementById('cartTotal').innerText='₹'+t;document.getElementById('cartBadge').innerText=c;localStorage.setItem("fe_cart",JSON.stringify(cart));}
function renderHome(){try{var p=JSON.parse(localStorage.getItem("fe_profile")||"null");if(p){document.getElementById('headerProfile').innerText=p.name.charAt(0).toUpperCase();document.getElementById('profileName').innerText=p.name;document.getElementById('profilePhone').innerText='+91 '+p.mobile;document.getElementById('profileAddr').innerText=(p.house||'')+' '+(p.street||'')+' '+p.city;document.getElementById('profilePicDiv').innerText=p.name.charAt(0).toUpperCase();if(p.pic){document.getElementById('profilePicDiv').innerHTML='<img src="'+p.pic+'" style="width:100%;height:100%;border-radius:50%;object-fit:cover">';}var loc=p.house? p.house+', '+p.city : p.city;document.getElementById('deliverLocation').innerText=loc;}}catch(e){}renderStoresBar();renderSelectedStore();renderCat();renderItems(menuData[currentStore]);try{var savedCart=JSON.parse(localStorage.getItem("fe_cart")||"[]");if(savedCart.length>0){cart=savedCart;updateCartUI();}}catch(e){}}
function getLiveLocation(){document.getElementById('liveStatus').innerText='Detecting...';if(navigator.geolocation){navigator.geolocation.getCurrentPosition(function(pos){var lat=pos.coords.latitude.toFixed(4);var lon=pos.coords.longitude.toFixed(4);document.getElementById('liveStatus').innerText='Found: '+lat+','+lon;document.getElementById('mapAddrText').innerText='Live: '+lat+','+lon+' (Karanjia)';},function(){document.getElementById('liveStatus').innerText='Failed - Allow location permission';});}else{document.getElementById('liveStatus').innerText='Not supported';}}
function confirmLoc(){var h=document.getElementById('mapHouse').value;var s=document.getElementById('mapStreet').value;var city=document.getElementById('mapCity').value||'Karanjia';var finalAddr=(h?h+', ':'')+(s?s+', ':'')+city;document.getElementById('deliverLocation').innerText=finalAddr.slice(0,24);try{var p=JSON.parse(localStorage.getItem("fe_profile")||"{}");p.house=h;p.street=s;p.city=city;localStorage.setItem("fe_profile",JSON.stringify(p));}catch(e){}showPage('homePage');}
function doLogout(){if(confirm("Log out karna hai baby? Profile saved rahega ❤️")){localStorage.removeItem("fe_cart");cart=[];updateCartUI();showPage('loginPage');document.getElementById('welcomeBack').style.display='none';alert("Log out ho gaya! Same number se login pe auto-fill ho jayega ❤️");}}
</script>
