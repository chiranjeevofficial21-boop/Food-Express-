</div>
<p id="mobileError" style="display:none;color:red;font-size:11px;margin-top:6px">❌ Valid Indian number dalo (10 digit, 6-9 se start)</p>

<!-- Ye fields mobile valid hone pe khulenge -->
<div id="extraFields" style="display:none">
<input id="userName" placeholder="Your Full Name *">
<input id="userPic" placeholder="Profile Picture Link (optional)">
<input id="userHouse" placeholder="House No / Landmark">
<input id="userStreet" placeholder="Street / Area">
<div style="display:flex;gap:10px">
<input id="userCity" value="Karanjia" placeholder="City">
<input id="userPin" value="757037" placeholder="Pincode">
</div>
<p style="font-size:10px;color:gray;margin-top:8px">* Ek bar bharne se auto-save ho jayega ❤️</p>
</div>

<button class="btn" onclick="handleLogin()">Continue →</button>
</div>
