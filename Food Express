<script>
// ============ PART 1 LOGIC ============
function showPage(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if(id=='homePage' && typeof renderHome==='function') renderHome();
}

function isValidIndianMobile(num){
  return /^[6-9][0-9]{9}$/.test(num);
}

function onMobileInput(){
  var v=document.getElementById('mobile').value.replace(/[^0-9]/g,'');
  document.getElementById('mobile').value=v;
  
  if(v.length==10){
    if(isValidIndianMobile(v)){
      document.getElementById('mobileError').style.display='none';
      document.getElementById('extraFields').style.display='block';
      // Auto-fill agar pehle se saved hai same number pe
      try{
        var saved=JSON.parse(localStorage.getItem("fe_profile")||"null");
        if(saved && saved.mobile==v){
          document.getElementById('userName').value=saved.name||'';
          document.getElementById('userPic').value=saved.pic||'';
          document.getElementById('userHouse').value=saved.house||'';
          document.getElementById('userStreet').value=saved.street||'';
          document.getElementById('userCity').value=saved.city||'Karanjia';
          document.getElementById('userPin').value=saved.pincode||'757037';
        }
      }catch(e){}
    }else{
      document.getElementById('mobileError').style.display='block';
      document.getElementById('extraFields').style.display='none';
    }
  }else{
    document.getElementById('extraFields').style.display='none';
  }
}

function handleLogin(){
  var num=document.getElementById('mobile').value;
  if(!isValidIndianMobile(num)){
    alert('Valid Indian number dalo baby! 6-9 se start hona chahiye');
    return;
  }
  var name=document.getElementById('userName').value;
  if(!name){
    alert('Name to dalo baby ❤️');
    return;
  }
  // Auto Save Profile
  var data={
    mobile:num,
    name:name,
    pic:document.getElementById('userPic').value||'',
    house:document.getElementById('userHouse').value||'',
    street:document.getElementById('userStreet').value||'',
    city:document.getElementById('userCity').value||'Karanjia',
    pincode:document.getElementById('userPin').value||'757037'
  };
  localStorage.setItem("fe_profile",JSON.stringify(data));
  
  // Agar Part 2 loaded hai to home pe jao
  if(typeof renderHome==='function'){
    showPage('homePage');
  }else{
    alert('Login success baby! ❤️ Profile auto-save ho gaya! Ab Part 2 add karo');
  }
}

// Welcome back message
try{
  var savedProfile=JSON.parse(localStorage.getItem("fe_profile")||"null");
  if(savedProfile && savedProfile.mobile){
    document.getElementById('welcomeBack').style.display='block';
    document.getElementById('welcomeBack').innerText='Welcome back '+savedProfile.name+'! ❤️';
  }
}catch(e){}
</script>
<!-- ================= PART 1 END ================= -->
